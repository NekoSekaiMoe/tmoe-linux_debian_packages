#!/bin/sh
set -e

case "$1" in
    purge)
        # Ask user if they want to remove user data
        echo "TMOE Python has been removed."
        echo "User data in ~/.config/tmoe-linux and ~/.local/share/tmoe-linux"
        echo "was NOT removed. You can delete these directories manually if desired."
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
