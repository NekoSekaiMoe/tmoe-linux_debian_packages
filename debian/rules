#!/usr/bin/make -f
# -*- makefile -*-

export PYBUILD_NAME=tmoe

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	python3 setup.py bdist_wheel

override_dh_python3:
	dh_python3 --shebang=/usr/bin/python3

override_dh_fixperms:
	dh_fixperms
	# Ensure scripts are executable
	chmod 755 $(CURDIR)/debian/tmoe-python/usr/bin/tmoe 2>/dev/null || true

override_dh_auto_install:
	python3 -m pip install dist/tmoe-*.whl --no-deps --target=$(CURDIR)/debian/tmoe-python/usr/lib/python3/dist-packages --ignore-installed
	# Move bin/tmoe to /usr/bin
	mkdir -p $(CURDIR)/debian/tmoe-python/usr/bin
	mv $(CURDIR)/debian/tmoe-python/usr/lib/python3/dist-packages/bin/tmoe $(CURDIR)/debian/tmoe-python/usr/bin/tmoe || true
	rmdir $(CURDIR)/debian/tmoe-python/usr/lib/python3/dist-packages/bin 2>/dev/null || true

override_dh_auto_test:
	python3 -m pytest || true

override_dh_usrlocal:
	# Skip dh_usrlocal check for /usr/local
