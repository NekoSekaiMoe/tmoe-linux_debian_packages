#!/usr/bin/make -f
# -*- makefile -*-

export PYBUILD_NAME=tmoe

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	-rm -rf build/ dist/ *.egg-info/
	dh_auto_clean

override_dh_auto_test:
	# Skip tests during build (dependencies not available in build environment)
	@echo "Skipping tests during build"

override_dh_auto_build:
	python3 setup.py bdist_wheel

override_dh_auto_install:
	python3 -m pip install \
		--no-deps \
		--no-index \
		--no-warn-script-location \
		--root=$(CURDIR)/debian/tmoe-python \
		dist/*.whl
	
	# Install additional files
	install -D -m 0644 debian/tmoe.desktop \
		$(CURDIR)/debian/tmoe-python/usr/share/applications/tmoe.desktop 2>/dev/null || true
	install -D -m 0644 debian/tmoe.svg \
		$(CURDIR)/debian/tmoe-python/usr/share/icons/hicolor/scalable/apps/tmoe.svg 2>/dev/null || true
	
	# Install man page
	install -D -m 0644 debian/tmoe.1 \
		$(CURDIR)/debian/tmoe-python/usr/share/man/man1/tmoe.1

override_dh_python3:
	dh_python3 --shebang=/usr/bin/python3

override_dh_fixperms:
	dh_fixperms
	# Ensure scripts are executable
	chmod 755 $(CURDIR)/debian/tmoe-python/usr/bin/tmoe 2>/dev/null || true

override_dh_usrlocal:
	# Skip dh_usrlocal check for /usr/local